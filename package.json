{
  "name": "career-ops",
  "version": "1.38.0",
  "description": "Open-source AI job search that runs locally in your AI coding CLI: scan job portals, evaluate listings into a structured A-H report with a 1-5 score, tailor your CV, track applications",
  "private": true,
  "engines": {
    "node": "^22.13.0 || >=23.4.0"
  },
  "scripts": {
    "doctor": "node doctor.mjs",
    "verify": "node verify-pipeline.mjs",
    "lint": "node scripts/check-syntax.mjs",
    "normalize": "node normalize-statuses.mjs",
    "dedup": "node dedup-tracker.mjs",
    "fix-report-links": "node fix-report-links.mjs",
    "merge": "node merge-tracker.mjs",
    "reconcile": "node reconcile-pipeline.mjs",
    "pdf": "node generate-pdf.mjs",
    "jd:similarity": "node jd-similarity.mjs",
    "img-to-pdf": "node img-to-pdf.mjs",
    "cover-letter": "node generate-cover-letter.mjs --payload",
    "cv:verify-facts": "node verify-cv-facts.mjs",
    "cv:verify-ats": "node verify-ats.mjs",
    "sync-check": "node cv-sync-check.mjs",
    "update:check": "node update-system.mjs check",
    "update": "node update-system.mjs apply --confirm",
    "rollback": "node update-system.mjs rollback",
    "liveness": "node check-liveness.mjs",
    "extract": "node browser-extract.mjs",
    "scan": "node scan.mjs",
    "scan:full": "node scan-ats-full.mjs",
    "company:funded": "node company-funded.mjs",
    "validate:portals": "node validate-portals.mjs",
    "verify:portals": "node verify-portals.mjs",
    "tracker": "node tracker.mjs",
    "find": "node find.mjs",
    "patterns": "node analyze-patterns.mjs",
    "keyword-match": "node keyword-match.mjs",
    "calibrate": "node calibrate.mjs",
    "upskill": "node upskill.mjs",
    "career-profile": "node career-profile.mjs",
    "add": "node add-entry.mjs",
    "reposts": "node detect-reposts.mjs",
    "filter-audit": "node filter-audit.mjs --summary",
    "digest": "node weekly-digest.mjs",
    "freshness": "node check-table-freshness.mjs",
    "jd-archive": "node check-jd-archive.mjs",
    "rejection-latency": "node rejection-latency.mjs",
    "role-clarity": "node role-clarity.mjs",
    "closing-soon": "node closing-soon.mjs",
    "close-stale": "node close-stale.mjs",
    "reeval-candidates": "node reeval-candidates.mjs",
    "invite-match": "node invite-match.mjs",
    "ics-interview": "node ics-interview.mjs",
    "panelist-roles": "node panelist-roles.mjs",
    "paste-reply": "node paste-reply.mjs",
    "privacy:status": "node privacy-status.mjs",
    "star": "node match-star.mjs",
    "archive": "node archive-posting.mjs",
    "prepare:application": "node prepare-application.mjs",
    "application:init": "node application-artifacts.mjs --init",
    "postinstall": "node -e \"process.exit(['','0','false'].includes((process.env.PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD||'').toLowerCase())?1:0)\" || npx playwright install chromium || npx playwright install chromium || node -e \"console.warn('\\ncareer-ops: could not install Playwright Chromium. Everything else is installed; PDF generation and browser checks need it. Run: npx playwright install chromium')\"",
    "manifesto": "node manifesto.mjs"
  },
  "keywords": [
    "ai",
    "job-search",
    "claude-code",
    "opencode",
    "career",
    "career-ops",
    "careerops",
    "automation",
    "codex",
    "antigravity",
    "qwen",
    "kimi",
    "copilot",
    "grok",
    "ai-agent-skill"
  ],
  "author": "Santiago Fernández de Valderrama <hi@santifer.io> (https://santifer.io)",
  "homepage": "https://career-ops.org",
  "repository": {
    "type": "git",
    "url": "https://github.com/career-ops-hq/career-ops"
  },
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "dotenv": "^18.0.4",
    "js-yaml": "^5.3.0",
    "nodemailer": "^10.3.1",
    "playwright": "1.64.1",
    "undici": "^7.30.1"
  }
}
